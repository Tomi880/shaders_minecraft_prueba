profile.comment = The six functional profiles will be added in phase 5; Iris treats empty profiles as invalid options.
option.SHADOW_FILTER_MODE = Shadow filter
option.SHADOW_FILTER_MODE.comment = PCF softens edges with fixed samples; PCSS estimates blockers for variable penumbrae (performance: medium–high).
value.SHADOW_FILTER_MODE.0 = PCF
value.SHADOW_FILTER_MODE.1 = PCSS
option.SHADOW_QUALITY = Filter samples
option.SHADOW_QUALITY.comment = Uses 4, 8, or 16 samples per search; more samples reduce noise at a higher cost (performance: medium–high).
value.SHADOW_QUALITY.0 = Performance
value.SHADOW_QUALITY.1 = Balanced
value.SHADOW_QUALITY.2 = Quality
option.SHADOW_STRENGTH = Shadow darkness
option.SHADOW_STRENGTH.comment = Controls how much sky light is darkened inside shadows (performance: low).
option.SHADOW_PENUMBRA = Penumbra width
option.SHADOW_PENUMBRA.comment = Adjusts PCSS penumbra size; it adds no samples but changes their spread (performance: low).
option.SHADOW_DISTORTION = Resolution distribution
option.SHADOW_DISTORTION.comment = Concentrates shadow-map texels near the center for useful detail; higher values warp the projection more (performance: low).
option.shadowMapResolution = Shadow map resolution
option.shadowMapResolution.comment = Increases map detail and memory/bandwidth use (performance: high).
value.shadowMapResolution.512 = 512 px
value.shadowMapResolution.1024 = 1024 px
value.shadowMapResolution.2048 = 2048 px
value.shadowMapResolution.4096 = 4096 px
option.shadowDistance = Shadow distance
option.shadowDistance.comment = Covers a larger area with less detail per texel; a greater distance can increase shadow-pass cost (performance: medium–high).
